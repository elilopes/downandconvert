{
  "entities": {
    "VisitorStats": {
      "title": "Visitor Stats",
      "description": "Global statistics for visitors.",
      "type": "object",
      "properties": {
        "count": {
          "type": "number"
        }
      },
      "required": ["count"]
    },
    "OnlineUser": {
      "title": "Online User",
      "description": "Tracks active user sessions.",
      "type": "object",
      "properties": {
        "lastSeen": {
          "type": "timestamp"
        }
      },
      "required": ["lastSeen"]
    },
    "UssdSearch": {
      "title": "USSD Search",
      "description": "Tracks popularity count of searched USSD codes.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "titleKey": {
          "type": "string"
        },
        "count": {
          "type": "number"
        },
        "lastSearched": {
          "type": "string"
        }
      },
      "required": ["code", "count"]
    }
  },
  "firestore": {
    "/stats/visitors": {
      "schema": { "$ref": "#/entities/VisitorStats" },
      "description": "The main global visitor counter"
    },
    "/online_users/{sessionId}": {
      "schema": { "$ref": "#/entities/OnlineUser" },
      "description": "Heartbeat documents for online users"
    },
    "/ussd_searches/{code}": {
      "schema": { "$ref": "#/entities/UssdSearch" },
      "description": "Aggregated search frequency for USSD codes"
    }
  }
}
